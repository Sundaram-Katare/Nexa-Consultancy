# ==========================================
# Supabase Cloud Database Configuration (Web)
# ==========================================
# Get these from: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Connection Pooling mode (Port 6543) or Direct (Port 5432):
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase API Settings (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==========================================
# n8n Orchestrator Configuration
# ==========================================
N8N_PORT=5678
N8N_ENCRYPTION_KEY=nexa_super_secret_encryption_key_32chars
N8N_HOST=localhost
N8N_PROTOCOL=http
GENERIC_TIMEZONE=UTC

# ==========================================
# Ollama Local LLM Configuration
# ==========================================
OLLAMA_URL=http://ollama:11434
OLLAMA_HOST_PORT=11434

# ==========================================
# Agent Configuration
# ==========================================
AGENT_PORT=3000
NODE_ENV=development
