# ==========================================
# PostgreSQL Database Configuration
# ==========================================
POSTGRES_USER=nexa_user
POSTGRES_PASSWORD=nexa_secure_password_123
POSTGRES_DB=nexa_consultancy_db
POSTGRES_HOST_PORT=5433

# Internal connection URL for services on the Docker network
DATABASE_URL=postgresql://nexa_user:nexa_secure_password_123@postgres:5432/nexa_consultancy_db

# ==========================================
# n8n Orchestrator Configuration
# ==========================================
N8N_PORT=5678
N8N_ENCRYPTION_KEY=nexa_super_secret_encryption_key_32chars
N8N_HOST=localhost
N8N_PROTOCOL=http
GENERIC_TIMEZONE=UTC

# ==========================================
# Ollama Local LLM Configuration
# ==========================================
OLLAMA_URL=http://ollama:11434
OLLAMA_HOST_PORT=11434

# ==========================================
# Agent Configuration
# ==========================================
AGENT_PORT=3000
NODE_ENV=development
