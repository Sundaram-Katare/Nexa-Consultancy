# ==============================================================================
# NEXA CONSULTANCY — AI BROWSER AUTOMATION AGENT ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL / Supabase Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL Connection URI (Supabase Cloud or Local Postgres instance):
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase Web & Auth API Settings (Optional if using direct Postgres pooler)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database Connection Pool Settings
NODE_ENV=development
DEBUG_SQL=false

# ------------------------------------------------------------------------------
# 2. Local AI / Ollama LLM Configuration
# ------------------------------------------------------------------------------
# HTTP URL for Ollama local service (default Docker container name or localhost)
OLLAMA_URL=http://ollama:11434
OLLAMA_HOST_PORT=11434

# Primary small, fast instruction model used for ambiguity resolution & NL parsing
# Recommended: qwen2.5:4b-instruct or llama3.2:3b
OLLAMA_MODEL=qwen2.5:4b-instruct

# ------------------------------------------------------------------------------
# 3. Agent Execution Engine & Fastify API
# ------------------------------------------------------------------------------
AGENT_PORT=3000
LOG_LEVEL=info
ERROR_LOGS_DIR=./logs/errors

# ------------------------------------------------------------------------------
# 4. Source Adapter Credentials (Optional / Credential-Gated Sites)
# ------------------------------------------------------------------------------
# Scribd optional login credentials for authenticated document access
# Leave blank to operate in public guest / preview mode
SCRIBD_USERNAME=
SCRIBD_PASSWORD=

# ------------------------------------------------------------------------------
# 5. n8n Workflow Automation & Orchestrator
# ------------------------------------------------------------------------------
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=nexa_super_secret_encryption_key_32chars
GENERIC_TIMEZONE=UTC
